# ── Database ───────────────────────────────────────────────────
# PostgreSQL connection string. On DeployBay, enable the PostgreSQL database
# and this is injected automatically as DATABASE_URL.
# Example: postgresql://user:pass@host:5432/dbname?sslmode=no-verify
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=no-verify

# Migrations run automatically on server boot. Set to "false" to disable
# (e.g. if you apply them out of band with `pnpm migrate`).
# RUN_MIGRATIONS_ON_BOOT=true

# ── OpenAI ─────────────────────────────────────────────────────
# Used for field extraction (gpt-4o) and summarization (gpt-4o-mini).
OPENAI_API_KEY=sk-...

# ── App ────────────────────────────────────────────────────────
# Public base URL of the deployment. Used to build links in CLI/log output.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional single shared-password gate. If set, every page/route requires this
# password (one login, one cookie — no user accounts). Leave unset to run open.
# APP_ACCESS_PASSWORD=choose-a-strong-password

# ── Salesforce (JWT Bearer Flow) ───────────────────────────────
# Preferred home for these secrets (env-first; the orgs row is a fallback).
SF_INSTANCE_URL=https://yourco.my.salesforce.com
SF_CLIENT_ID=consumer-key-from-connected-app
SF_USERNAME=integration.user@yourco.com
# The RSA private key (PEM). Use the base64 form to avoid multi-line env issues:
#   base64 -i server.key | tr -d '\n'
SF_PRIVATE_KEY_BASE64=
# ...or provide the raw PEM (real newlines, or \n-escaped on one line):
# SF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── Gong (optional) ────────────────────────────────────────────
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
# GONG_BASE_URL=https://us-XXXXX.api.gong.io

# ── Outreach (optional) ────────────────────────────────────────
# Run `pnpm oauth:outreach` to obtain the refresh token.
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
OUTREACH_REFRESH_TOKEN=

# ── Webhook (optional) ─────────────────────────────────────────
# Shared secret for the Salesforce APEX trigger -> POST /api/data-entry/webhook.
WEBHOOK_SECRET=change-me

# ── Queue processor (optional) ─────────────────────────────────
# Bearer secret required to call GET /api/data-entry/process-queue.
# Have an external scheduler (cron) hit that endpoint on an interval.
CRON_SECRET=change-me

# ── Data import (optional) ─────────────────────────────────────
# Bearer secret enabling POST /api/admin/import (bulk data load from outside the
# DB's network). Unset = endpoint disabled. See "Importing data" in the README.
# IMPORT_SECRET=change-me

# NOTE: integration credentials are read env-first (above) and fall back to the
# `orgs` table. Putting them in env keeps the private key out of the database and
# its backups. The DB columns remain supported — see supabase/seed.example.sql.
