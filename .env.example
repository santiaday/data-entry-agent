# ── Database ───────────────────────────────────────────────────
# PostgreSQL connection string. On DeployBay, enable the PostgreSQL database
# and this is injected automatically as DATABASE_URL.
# Example: postgresql://user:pass@host:5432/dbname?sslmode=no-verify
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=no-verify

# Migrations run automatically on server boot. Set to "false" to disable
# (e.g. if you apply them out of band with `pnpm migrate`).
# RUN_MIGRATIONS_ON_BOOT=true

# ── OpenAI ─────────────────────────────────────────────────────
# Used for field extraction (gpt-4o) and summarization (gpt-4o-mini).
OPENAI_API_KEY=sk-...

# ── App ────────────────────────────────────────────────────────
# Public base URL of the deployment. Used to build links in CLI/log output.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Webhook (optional) ─────────────────────────────────────────
# Shared secret for the Salesforce APEX trigger -> POST /api/data-entry/webhook.
WEBHOOK_SECRET=change-me

# ── Queue processor (optional) ─────────────────────────────────
# Bearer secret required to call GET /api/data-entry/process-queue.
# Have an external scheduler (cron) hit that endpoint on an interval.
CRON_SECRET=change-me

# NOTE: Salesforce / Gong / Outreach credentials are NOT set here.
# They live in the `orgs` table (one row per org). See supabase/seed.example.sql.
