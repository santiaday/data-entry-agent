# Data-Entry Agent — DeployBay control panel (revops-agents backend)
#
# This app is a THIN control panel. It does NOT run the extraction pipeline,
# hold Salesforce/Gong/Outreach/OpenAI credentials, talk to a database, or do
# its own authorization. All of that lives in revops-agents. The UI calls the
# revops-agents data-entry control-panel Lambda API, which owns DB access (as
# the least-privilege `data_entry_agent` Postgres role) and enforces roles.

# ── revops-agents data-entry Lambda API (REQUIRED) ─────────────
# Base URL of the data-entry control-panel API on the revops-agents HTTP API
# Gateway. Every former /api/data-entry/<sub> route is served under this base
# (e.g. <base>/run, <base>/queue, <base>/fields, <base>/runs/<id>). This is NOT
# a secret → it is shipped to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_DATA_ENTRY_API_BASE=https://1r7hjb5jv6.execute-api.us-east-1.amazonaws.com/prod/data-entry
# Shared bearer attached as the X-Internal-Secret header on every request to
# the Lambda. NOTE: NEXT_PUBLIC_* values are inlined into the browser bundle, so
# this token is browser-exposed by design — keep it scoped to this UI and rotate
# it independently of any server-only secrets.
NEXT_PUBLIC_DATA_ENTRY_API_TOKEN=replace-with-bearer

# ── App access ─────────────────────────────────────────────────
# DeployBay's ingress grant is the outer gate. Optionally also require a shared
# password (one login, one cookie). Leave unset to rely on DeployBay's gate.
# APP_ACCESS_PASSWORD=choose-a-strong-password

# Public base URL of the deployment (used for links in log output).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Roles & attribution (now enforced by the Lambda) ───────────
# Per-user roles and attribution moved server-side into the revops-agents
# data-entry Lambda along with the API. The former frontend role vars
# (REVOPS_DEFAULT_ROLE, REVOPS_EDITOR_EMAILS, REVOPS_INGRESS_SECRET,
# REVOPS_INGRESS_SECRET_HEADER, REVOPS_IDENTITY_TRUSTED, REVOPS_USER_HEADER) are
# NO LONGER read by this app — configure authorization on the Lambda instead.

# ── App access gate ────────────────────────────────────────────
# Set true when an external gate (e.g. DeployBay's ingress grant) fronts the app
# and no APP_ACCESS_PASSWORD is set — otherwise the app fails CLOSED.
REVOPS_EXTERNAL_GATE=true

# Never set in revops-backed mode (the UI does not own/migrate the DB).
RUN_MIGRATIONS_ON_BOOT=false
