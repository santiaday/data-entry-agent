# Data-Entry Agent — DeployBay control panel (revops-agents backend)
#
# This app is a THIN control panel. It does NOT run the extraction pipeline,
# hold Salesforce/Gong/Outreach/OpenAI credentials, or own a database. All of
# that lives in revops-agents. The UI reaches revops-db ONLY through the
# revops-agents SQL endpoint, authenticating as the least-privilege
# `data_entry_agent` Postgres role.

# ── revops-agents SQL endpoint (REQUIRED) ──────────────────────
# Base URL of the webhooks service that hosts POST /db/{database}/sql.
REVOPS_SQL_ENDPOINT=https://1r7hjb5jv6.execute-api.us-east-1.amazonaws.com/prod
# Target database + the Postgres role identity the UI assumes.
REVOPS_DB_NAME=revops_agent_platform
REVOPS_DB_IDENTITY=data_entry_agent
# Per-identity bearer (Secrets Manager: revops/db-query/identities/data_entry_agent-bearer).
REVOPS_DB_BEARER=replace-with-bearer
# Optional tuning:
# REVOPS_SQL_MAX_ROWS=5000
# REVOPS_SQL_TIMEOUT_MS=25000

# The agent_ref this UI manages (config rows + dispatch queue are scoped to it).
AGENT_REF=sales/data-entry-agent

# ── App access ─────────────────────────────────────────────────
# DeployBay's ingress grant is the outer gate. Optionally also require a shared
# password (one login, one cookie). Leave unset to rely on DeployBay's gate.
# APP_ACCESS_PASSWORD=choose-a-strong-password

# Public base URL of the deployment (used for links in log output).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Roles & attribution (optional) ─────────────────────────────
# If your ingress forwards the signed-in user's email in a header, set its name
# here (defaults checked: x-deploybay-user, x-forwarded-email, x-auth-request-email).
# REVOPS_USER_HEADER=x-deploybay-user
# Comma-separated emails that get EDITOR access (edit prompts/fields, trigger runs).
# When set + a user email is present, everyone else is read-only. When unset,
# every authenticated user gets REVOPS_DEFAULT_ROLE.
# REVOPS_EDITOR_EMAILS=leadership@doorloop.com,saday@doorloop.com
# Default role when no editor allowlist / no user identity is available.
# 'editor' (default) preserves single-tenant full control behind the gate.
# REVOPS_DEFAULT_ROLE=editor

# Never set in revops-backed mode (the UI does not own/migrate the DB).
RUN_MIGRATIONS_ON_BOOT=false
